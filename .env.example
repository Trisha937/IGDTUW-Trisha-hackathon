# Copy this file to .env and fill in your real keys
# cp .env.example .env

# Apify API Token (free $5/month tier)
# Get yours at: https://apify.com → Settings → Integrations → API Token
APIFY_API_TOKEN=your_apify_token_here

# NVIDIA API Key (free tier)
# Get yours at: https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=your_nvidia_api_key_here
